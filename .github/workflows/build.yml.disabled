# DISABLED on purpose: github only runs *.yml / *.yaml files in this folder, so this one is parked as build.yml.disabled.
# only the cloud agent (which cannot run the app) needs ci; the maintainer builds and tests locally with tools\verify.bat ui.
# to turn it on again: rename this file back to build.yml (git mv .github/workflows/build.yml.disabled .github/workflows/build.yml).
name: build

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  windows-x86:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      # puts the 32-bit msvc toolchain (cl / ml / link / rc) on the path; build.bat then skips its own vcvars lookup
      - name: msvc x86 environment
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x86

      # the exit code is not enough: cl /W3 and link print warnings and still succeed, and the project promises none
      - name: build (release, zero warnings)
        shell: pwsh
        run: |
          cmd /c build.bat 2>&1 | Tee-Object -FilePath build-release.log
          if ($LASTEXITCODE -ne 0) { throw "build.bat failed" }
          $w = Select-String -Path build-release.log -Pattern 'warning\s+[A-Z]+\d+'
          if ($w) { $w | ForEach-Object { Write-Host $_.Line }; throw "the build printed warnings" }

      - name: imports (kernel32 / user32 / gdi32 only, 32-bit)
        shell: pwsh
        run: ./tools/check_imports.ps1

      - name: dumpbin /imports (for the log)
        shell: cmd
        run: dumpbin /imports build\notepad-mint.exe

      # src/w32.h is hand written: prove its struct layouts, constants and api byte counts match the real 32-bit sdk
      - name: layout check (w32.h vs the real sdk)
        shell: cmd
        run: tools\layout_check\check.bat

      # no crt, like the app: builds build\tests\unit.exe and runs it (the exit code is the result)
      - name: unit tests
        shell: cmd
        run: tests\unit\build.bat

      - name: upload exe
        uses: actions/upload-artifact@v4
        with:
          name: notepad-mint-x86
          path: build/notepad-mint.exe

      # needs a desktop session on the runner. does not fail the job yet: harden it as it proves stable
      - name: smoke test (starts, opens a file, stays alive, right title)
        shell: pwsh
        continue-on-error: true
        run: ./tools/smoke.ps1

      - name: upload smoke screenshot
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: smoke-screenshot
          path: build/smoke.png
          if-no-files-found: ignore

      - name: build (debug, compile check, zero warnings)
        shell: pwsh
        run: |
          cmd /c build.bat dbg 2>&1 | Tee-Object -FilePath build-debug.log
          if ($LASTEXITCODE -ne 0) { throw "build.bat dbg failed" }
          $w = Select-String -Path build-debug.log -Pattern 'warning\s+[A-Z]+\d+'
          if ($w) { $w | ForEach-Object { Write-Host $_.Line }; throw "the debug build printed warnings" }
