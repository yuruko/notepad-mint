/* notepad_mint.rc - icon, manifest (per-monitor-v2 dpi) and version info.
 * no windows.h / winver.h here either, so the constants are spelled out.
 * paths are relative to the project root (build.bat runs rc from there). */

1 24 "src\\notepad_mint.manifest"
1 ICON "assets\\notepad_mint.ico"

1 VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "notepad mint"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "notepad mint"
            VALUE "LegalCopyright", "free software. no ai, no sign-in, no telemetry."
            VALUE "OriginalFilename", "notepad-mint.exe"
            VALUE "ProductName", "notepad mint"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
